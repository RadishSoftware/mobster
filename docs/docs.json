{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "Mobster",
  "description": "Test and automate apps on real iPhones. Run tasks in your apps, signed in as you, over USB from your Mac.",
  "colors": {
    "primary": "#5B41E8",
    "light": "#A493FF",
    "dark": "#6E56F6"
  },
  "background": {
    "color": {
      "light": "#F8F8F8",
      "dark": "#121212"
    }
  },
  "logo": {
    "light": "/brand/logo/lockup-light.svg",
    "dark": "/brand/logo/lockup-dark.svg"
  },
  "favicon": "/brand/favicon/favicon.svg",
  "fonts": {
    "family": "Mobster Sans",
    "source": "/fonts/google-sans-flex.woff2",
    "format": "woff2"
  },
  "icons": {
    "library": "lucide"
  },
  "appearance": {
    "default": "system"
  },
  "styling": {
    "codeblocks": {
      "theme": "css-variables"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:support@radish.software"
      },
      {
        "label": "GitHub",
        "href": "https://github.com/RadishSoftware/mobster"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get Mobster",
      "href": "https://mobster.dev"
    }
  },
