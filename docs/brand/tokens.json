  "data": {
    "about": "Charts' categorical colours, in this order, never cycled: past five series a chart folds the rest into Other in ink-4. Validated 15 Oct 2026 (the dataviz validator, on the card surfaces light #F2F0ED and dark #1C1B1F, and on paper light #F8F8F8 and dark #111014): adjacent colour-blind ΔE at least 8.4, normal ΔE at least 17.3, every slot at least 3:1 on both grounds in both appearances, and the first three apart in every pair (scatter). Words stay in ink, never in a series colour. Violet is the agent's, and green, amber and coral are status: none is a series colour.",
    "light": ["#2A78D6", "#E3612C", "#009D6B", "#B97D04", "#D1668F"],
    "dark": ["#3987E5", "#D95926", "#199E70", "#C98500", "#D55181"]
  },
  "code": {
    "about": "Code and terminal output on every surface (product/VISUAL-LANGUAGE.md, Code): each role names a palette colour, so it follows the appearance. Two hues at most: violet for keywords and a config file's keys, green for strings and a ✓ mark. Commands, flags, functions, types and numbers stay ink; comments, punctuation and the $ prompt are the third grey; output is the second grey; coral marks a ✗ and nothing else. The plate is the card fill, with no border in light and the card's own ring in dark.",
    "role": {
      "text": "ink",
      "output": "ink-2",
      "muted": "ink-3",
      "keyword": "violet-text",
      "string": "green",
      "ok": "green",
      "fail": "coral"
    },
    "plate": "card"
  },
