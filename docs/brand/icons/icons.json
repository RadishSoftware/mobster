{
  "about": "Mobster's icons: one set for the Mac app, mobster.dev, Remote and the docs. Each icon is drawn once, on a 24 unit grid, in svg/<name>.svg; scripts/gen_icons.py writes every surface's copy. See README.md.",
  "grid": 24,
  "stroke": {
    "about": "The line in CSS px at a rendered size s is 0.5 + s / 16: 1.25 at 12, 1.375 at 14, 1.5 at 16, 1.75 at 20, 2 at 24. The 16 px line is Mobster Sans's 500 stem at 14 px (1.52 px), the label beside it; larger icons get relatively lighter, as optical sizes do.",
    "base": 0.5,
    "perPx": 0.0625
  },
  "sizes": [
    12,
    14,
    16,
    20,
    24
  ],
  "motions": {
