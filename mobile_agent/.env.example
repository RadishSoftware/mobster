TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Gemini text/recovery helper, authenticated through an existing gcloud login.
# This file is a configuration example; the server does not auto-load it.
TEXT_MODEL_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
TEXT_MODEL=gemini-3.5-flash-lite
# Alternatively choose a compatible JSON-object chat provider explicitly:
# TEXT_MODEL_PROVIDER=openai-compatible
# TEXT_MODEL_API_KEY=
# TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
# TEXT_MODEL=
